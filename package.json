{
  "name": "min-atoms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  },
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "test": "bun test",
    "lint": "bun run --filter \"*\" lint && tsc --noEmit",
    "build": "bun run --filter \"*\" check && bun run --cwd apps/web build",
    "db:generate": "bun run --cwd packages/db db:generate",
    "db:migrate": "bun run --cwd packages/db db:migrate",
    "db:seed": "bun run --cwd packages/db db:seed"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "^22.19.15",
    "typescript": "^5.9.3"
  }
}
