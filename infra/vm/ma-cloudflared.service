[Unit]
Description=min-atoms dedicated tunnel connector
Wants=network-online.target
After=network-online.target ma-manager.service ma-gateway.service

[Service]
EnvironmentFile=/etc/min-atoms/env
UnsetEnvironment=DEEPSEEK_API_KEY
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
